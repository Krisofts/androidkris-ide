<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme is the platform Material Light NoActionBar; Compose supplies the
         real color scheme at runtime. values-night overrides for dark mode. -->
    <style name="Theme.AndroidKrisIDE" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
